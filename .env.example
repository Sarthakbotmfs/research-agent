# Research Agent Environment Configuration
# Copy this file to .env and configure as needed.

# Application Environment
ENV=development
LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=8000
FRONTEND_ORIGIN=http://localhost:5173

# Database (SQLite default for local-first execution)
DATABASE_URL=sqlite+aiosqlite:///./data/research_agent.db

# LLM Provider Configuration (OpenAI-compatible)
# If left blank, system runs in discovery-only mode or structured heuristic classification
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=4096

# Scholarly Discovery APIs
# Crossref politely requests a contact email in the User-Agent header
CROSSREF_MAILTO=research-agent@example.com
OPENALEX_EMAIL=research-agent@example.com

# Execution Limits
MAX_RESEARCH_ROUNDS=3
MAX_SEARCH_QUERIES=15
MAX_UNIQUE_SOURCES=40
MAX_PAGE_FETCHES=20
TASK_TIMEOUT_SECONDS=600
CONCURRENCY_LIMIT=4
